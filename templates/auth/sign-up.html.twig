{% extends 'front_base.html.twig' %}

{% block title %}Sign Up - Unilearn{% endblock %}

{% block content %}

<!-- **************** MAIN CONTENT START **************** -->
<main>
	<section class="p-0 d-flex align-items-center position-relative overflow-hidden">
	
		<div class="container-fluid">
			<div class="row">
				<!-- left -->
				<div class="col-12 col-lg-6 d-md-flex align-items-center justify-content-center bg-primary bg-opacity-10 vh-lg-100">
					<div class="p-3 p-lg-5">
						<!-- Title -->
						<div class="text-center">
							<h2 class="fw-bold">Welcome to our largest community</h2>
							<p class="mb-0 h6 fw-light">Let's learn something new today!</p>
						</div>
						<!-- SVG Image -->
						<img src="{{ asset('assets/images/element/02.svg') }}" class="mt-5" alt="">
						<!-- Info -->
						<div class="d-sm-flex mt-5 align-items-center justify-content-center">
							<!-- Avatar group -->
							<ul class="avatar-group mb-2 mb-sm-0">
								<li class="avatar avatar-sm">
									<img class="avatar-img rounded-circle" src="{{ asset('assets/images/avatar/01.jpg') }}" alt="avatar">
								</li>
								<li class="avatar avatar-sm">
									<img class="avatar-img rounded-circle" src="{{ asset('assets/images/avatar/02.jpg') }}" alt="avatar">
								</li>
								<li class="avatar avatar-sm">
									<img class="avatar-img rounded-circle" src="{{ asset('assets/images/avatar/03.jpg') }}" alt="avatar">
								</li>
								<li class="avatar avatar-sm">
									<img class="avatar-img rounded-circle" src="{{ asset('assets/images/avatar/04.jpg') }}" alt="avatar">
								</li>
							</ul>
							<!-- Content -->
							<p class="mb-0 h6 fw-light ms-0 ms-sm-3">4k+ Students joined us, now it's your turn.</p>
						</div>
					</div>
				</div>

				<!-- Right -->
				<div class="col-12 col-lg-6 m-auto">
					<div class="row my-5">
						<div class="col-sm-10 col-xl-8 m-auto">
							<!-- Title -->
							<span class="mb-0 fs-1">👋</span>
							<h1 class="fs-2">Sign Up into Unilearn!</h1>
							<p class="lead mb-4">Nice to see you! Please Sign up with your account.</p>
							
							<!-- Flash messages -->
							{% for type, messages in app.session.flashbag.all() %}
								{% for message in messages %}
									{% if type == 'account_exists' %}
										<div class="alert alert-warning alert-dismissible fade show" role="alert">
											<div class="d-flex align-items-center">
												<div class="flex-grow-1">
													<h6 class="alert-heading mb-1">
														<i class="fas fa-exclamation-triangle me-2"></i>
														Account Already Exists
													</h6>
													<p class="mb-2">{{ message }}</p>
													<div class="d-flex gap-2">
														<a href="{{ path('app_sign_in') }}" class="btn btn-primary btn-sm">
															<i class="fas fa-sign-in-alt me-1"></i>Sign In
														</a>
														<button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="alert">
															<i class="fas fa-redo me-1"></i>Try Again
														</button>
													</div>
												</div>
											</div>
											<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
										</div>
									{% else %}
										<div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
											{{ message }}
											<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
										</div>
									{% endif %}
								{% endfor %}
							{% endfor %}
							
							<!-- Debug: Show form errors if any -->
							{% if not registrationForm.vars.valid %}
								<div class="alert alert-danger">
									<h5>Form Errors:</h5>
									<ul>
										{% for error in registrationForm.vars.errors %}
											<li>{{ error.message }}</li>
										{% endfor %}
										{% for child in registrationForm.children %}
											{% if not child.vars.valid %}
												{% for error in child.vars.errors %}
													<li>{{ child.vars.name }}: {{ error.message }}</li>
												{% endfor %}
											{% endif %}
										{% endfor %}
									</ul>
								</div>
							{% endif %}
						
							<!-- Form START -->
							{{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}
								<!-- Full Name -->
								<div class="mb-4">
									<label for="{{ registrationForm.fullName.vars.id }}" class="form-label">Full Name *</label>
									<div class="input-group input-group-lg">
										<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="bi bi-person-fill"></i></span>
										{{ form_widget(registrationForm.fullName, {'attr': {'class': 'form-control border-0 bg-light rounded-end ps-1', 'placeholder': 'Enter your full name', 'novalidate': 'novalidate'}}) }}
									</div>
									{{ form_errors(registrationForm.fullName) }}
								</div>
								<!-- Email -->
								<div class="mb-4">
									<label for="{{ registrationForm.email.vars.id }}" class="form-label">Email address *</label>
									<div class="input-group input-group-lg">
										<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="bi bi-envelope-fill"></i></span>
										{{ form_widget(registrationForm.email, {'attr': {'class': 'form-control border-0 bg-light rounded-end ps-1', 'placeholder': 'Enter your email', 'novalidate': 'novalidate'}}) }}
									</div>
									{{ form_errors(registrationForm.email) }}
								</div>
								<!-- Password -->
								<div class="mb-4">
									<label for="{{ registrationForm.password.first.vars.id }}" class="form-label">Password *</label>
									<div class="input-group input-group-lg">
										<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="fas fa-lock"></i></span>
										{{ form_widget(registrationForm.password.first, {'attr': {'class': 'form-control border-0 bg-light rounded-end ps-1', 'placeholder': 'Enter your password', 'novalidate': 'novalidate', 'autocomplete': 'new-password'}}) }}
									</div>
									{{ form_errors(registrationForm.password.first) }}
								</div>
								<!-- Confirm Password -->
								<div class="mb-4">
									<label for="{{ registrationForm.password.second.vars.id }}" class="form-label">Confirm Password *</label>
									<div class="input-group input-group-lg">
										<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="fas fa-lock"></i></span>
										{{ form_widget(registrationForm.password.second, {'attr': {'class': 'form-control border-0 bg-light rounded-end ps-1', 'placeholder': 'Confirm your password', 'novalidate': 'novalidate', 'autocomplete': 'new-password'}}) }}
									</div>
									{{ form_errors(registrationForm.password.second) }}
								</div>
								<!-- Check box -->
								<div class="mb-4">
									<div class="form-check">
										{{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
										{{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'form-check-label'}}) }}
									</div>
									{{ form_errors(registrationForm.agreeTerms) }}
								</div>

								<!-- Face Registration (Optional) -->
								<div class="mb-4">
									<div class="card border-info">
										<div class="card-header bg-info bg-opacity-10 text-info py-2">
											<i class="fas fa-fingerprint me-2"></i>Face Recognition (Optional)
										</div>
										<div class="card-body p-3">
											<p class="small text-muted mb-2">Enable face recognition for faster, password-free login.</p>
											<button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#faceRegistrationModal">
												<i class="fas fa-camera me-2"></i>Register Face
											</button>
											{{ form_widget(registrationForm.faceImage, {'attr': {'id': 'faceImageInput'}}) }}
											<div id="faceRegistrationStatus" class="mt-2 small d-none text-success">
												<i class="fas fa-check-circle me-1"></i>Face registered!
											</div>
										</div>
									</div>
								</div>

								<!-- Button -->
								<div class="align-items-center mt-0">
									<div class="d-grid">
										<button class="btn btn-primary mb-0" type="submit">Sign Up</button>
									</div>
								</div>
								<!-- Hidden input moved inside form -->
							{{ form_end(registrationForm) }}
							<!-- Form END -->

							<!-- Social buttons -->
							<div class="row">
								<!-- Divider with text -->
								<div class="position-relative my-4">
									<hr>
									<p class="small position-absolute top-50 start-50 translate-middle bg-body px-5">Or</p>
								</div>
								<!-- Social btn -->
								<div class="col-xxl-6 d-grid">
									<a href="{{ path('auth_google') }}" class="btn bg-google mb-2 mb-xxl-0"><i class="fab fa-fw fa-google text-white me-2"></i>Signup with Google</a>
								</div>
								<!-- Social btn -->
								<div class="col-xxl-6 d-grid">
									<a href="{{ path('auth_facebook') }}" class="btn bg-facebook mb-0"><i class="fab fa-fw fa-facebook-f me-2"></i>Signup with Facebook</a>
								</div>
							</div>

							<!-- Sign up link -->
							<div class="mt-4 text-center">
								<span>Already have an account?<a href="{{ path('app_sign_in') }}"> Sign in here</a></span>
							</div>
						</div>
					</div> <!-- Row END -->
				</div>
			</div> <!-- Row END -->
		</div>
	</section>
</main>
<!-- **************** MAIN CONTENT END **************** -->

{% endblock %}

{% block javascripts %}
{{ parent() }}

<!-- Face Registration Modal -->
<div class="modal fade" id="faceRegistrationModal" tabindex="-1" aria-labelledby="faceRegistrationModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-info text-white">
				<h5 class="modal-title" id="faceRegistrationModalLabel">
					<i class="fas fa-camera me-2"></i>Register Your Face
				</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div class="alert alert-info">
					<i class="fas fa-info-circle me-2"></i>
					Position your face within the frame and ensure good lighting.
				</div>
				<div class="position-relative mb-3">
					<video id="faceVideo" width="100%" height="400" autoplay playsinline 
						   style="border-radius: 8px; background: #000;"></video>
					<canvas id="faceCanvas" width="640" height="480" 
							style="border-radius: 8px; background: #f8f9fa; width: 100%; height: 400px; display: none;"></canvas>
				</div>
				<div class="text-center">
					<button type="button" id="startCameraBtn" class="btn btn-secondary mb-2 d-none">
						<i class="fas fa-video me-2"></i>Start Camera
					</button>
					<button type="button" id="captureFaceBtn" class="btn btn-primary btn-lg" disabled>
						<i class="fas fa-spinner fa-spin me-2"></i>Loading...
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
/**
 * Face Authentication JavaScript Module - Inline for sign-up page
 */
if (typeof FaceAuth === 'undefined') {
    class FaceAuth {
        constructor() {
            this.video = null;
            this.canvas = null;
            this.stream = null;
            this.isInitialized = false;
        }

        async initWebcam(videoElementId, canvasElementId) {
            this.video = document.getElementById(videoElementId);
            this.canvas = document.getElementById(canvasElementId);

            if (!this.video || !this.canvas) {
                console.error('Video or canvas element not found');
                return false;
            }

            try {
                console.log('Requesting camera access...');
                this.stream = await navigator.mediaDevices.getUserMedia({
                    video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: 'user' },
                    audio: false
                });

                this.video.srcObject = this.stream;
                this.video.style.display = 'block';
                this.canvas.style.display = 'none';

                return new Promise((resolve) => {
                    const timeout = setTimeout(() => {
                        console.warn('Video metadata timeout, trying anyway...');
                        this.isInitialized = true;
                        resolve(true);
                    }, 3000);

                    this.video.onloadedmetadata = () => {
                        clearTimeout(timeout);
                        this.video.play().then(() => {
                            this.isInitialized = true;
                            console.log('Webcam initialized');
                            resolve(true);
                        }).catch(() => resolve(false));
                    };
                });
            } catch (error) {
                console.error('Error accessing webcam:', error);
                this.isInitialized = false;
                return false;
            }
        }

        captureImage() {
            console.log('Capture attempt - isInitialized:', this.isInitialized, 'video:', !!this.video, 'canvas:', !!this.canvas);
            
            if (!this.isInitialized) {
                alert('Camera not initialized. Please wait or click "Start Camera".');
                return null;
            }
            
            if (!this.video || !this.canvas) {
                alert('Video or canvas element not found.');
                return null;
            }

            const context = this.canvas.getContext('2d');
            this.canvas.width = this.video.videoWidth || 640;
            this.canvas.height = this.video.videoHeight || 480;
            context.drawImage(this.video, 0, 0, this.canvas.width, this.canvas.height);
            
            this.video.style.display = 'none';
            this.canvas.style.display = 'block';

            return this.canvas.toDataURL('image/jpeg', 0.9);
        }

        stopWebcam() {
            if (this.stream) {
                this.stream.getTracks().forEach(track => track.stop());
                this.stream = null;
            }
            if (this.video) {
                this.video.srcObject = null;
            }
            this.isInitialized = false;
        }
    }

    window.FaceAuth = FaceAuth;
}

// Initialize FaceAuth for this page
const faceAuth = new FaceAuth();

document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('faceRegistrationModal');
    const captureBtn = document.getElementById('captureFaceBtn');
    const startCameraBtn = document.getElementById('startCameraBtn');
    // Find the faceImage input by name attribute since Symfony generates dynamic IDs
    const faceInput = document.querySelector('input[name$="[faceImage]"]');
    const statusDiv = document.getElementById('faceRegistrationStatus');
    
    if (!modal || !captureBtn) return;

    let cameraStarted = false;

    async function startCamera() {
        if (cameraStarted) return true;
        
        captureBtn.disabled = true;
        captureBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Starting...';
        
        const success = await faceAuth.initWebcam('faceVideo', 'faceCanvas');
        if (success) {
            cameraStarted = true;
            captureBtn.disabled = false;
            captureBtn.innerHTML = '<i class="fas fa-camera me-2"></i>Capture Face';
            if (startCameraBtn) startCameraBtn.classList.add('d-none');
            return true;
        } else {
            captureBtn.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>Camera Error';
            if (startCameraBtn) {
                startCameraBtn.classList.remove('d-none');
                startCameraBtn.onclick = startCamera;
            }
            return false;
        }
    }

    modal.addEventListener('shown.bs.modal', function() {
        setTimeout(startCamera, 300);
    });

    modal.addEventListener('hidden.bs.modal', function() {
        faceAuth.stopWebcam();
        cameraStarted = false;
        captureBtn.disabled = true;
        captureBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Loading...';
    });

    captureBtn.addEventListener('click', function() {
        if (!cameraStarted) {
            alert('Camera not ready. Please wait or click "Start Camera".');
            return;
        }
        
        const imageData = faceAuth.captureImage();
        console.log('Captured image data length:', imageData ? imageData.length : 0);
        console.log('Image data preview:', imageData ? imageData.substring(0, 50) + '...' : 'null');
        if (imageData) {
            if (faceInput) {
                faceInput.value = imageData;
                console.log('Face image saved to input');
            } else {
                console.error('Face input not found');
            }
            if (statusDiv) {
                statusDiv.classList.remove('d-none');
                console.log('Status shown');
            }
            bootstrap.Modal.getInstance(modal).hide();
            faceAuth.stopWebcam();
            cameraStarted = false;
        }
    });
});
</script>
{% endblock %}
