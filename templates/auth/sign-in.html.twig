{% extends 'front_base.html.twig' %}

{% block title %}Sign In - Unilearn{% endblock %}

{% block content %}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<!-- **************** MAIN CONTENT START **************** -->
<main>
	<section class="p-0 d-flex align-items-center position-relative overflow-hidden">
	
		<div class="container-fluid">
			<div class="row">
				<!-- left -->
				<div class="col-12 col-lg-6 d-md-flex align-items-center justify-content-center bg-primary bg-opacity-10 vh-lg-100">
					<div class="p-3 p-lg-5">
						<!-- Title -->
						<div class="text-center">
							<h2 class="fw-bold">Welcome back!</h2>
							<p class="mb-0 h6 fw-light">Nice to see you again, please login to your account.</p>
						</div>
						<!-- SVG Image -->
						<img src="{{ asset('assets/images/element/03.svg') }}" class="mt-5" alt="">
						<!-- Info -->
						<div class="d-sm-flex mt-5 align-items-center justify-content-center">
							<!-- Avatar group -->
							<ul class="avatar-group mb-2 mb-sm-0">
								<li class="avatar avatar-sm">
									<img class="avatar-img rounded-circle" src="{{ asset('assets/images/avatar/01.jpg') }}" alt="avatar">
								</li>
								<li class="avatar avatar-sm">
									<img class="avatar-img rounded-circle" src="{{ asset('assets/images/avatar/02.jpg') }}" alt="avatar">
								</li>
								<li class="avatar avatar-sm">
									<img class="avatar-img rounded-circle" src="{{ asset('assets/images/avatar/03.jpg') }}" alt="avatar">
								</li>
								<li class="avatar avatar-sm">
									<img class="avatar-img rounded-circle" src="{{ asset('assets/images/avatar/04.jpg') }}" alt="avatar">
								</li>
							</ul>
							<!-- Content -->
							<p class="mb-0 h6 fw-light ms-0 ms-sm-3">4k+ Students joined us, now it's your turn.</p>
						</div>
					</div>
				</div>

				<!-- Right -->
				<div class="col-12 col-lg-6 m-auto">
					<div class="row my-5">
						<div class="col-sm-10 col-xl-8 m-auto">
							<!-- Title -->
							<span class="mb-0 fs-1">👋</span>
							<h1 class="fs-2">Sign In into Unilearn!</h1>
							<p class="lead mb-4">Nice to see you again! Please login to your account.</p>
							
							<!-- Alert -->
							{% if error %}
								<div class="alert alert-danger">
									{{ error.messageKey|trans(error.messageData, 'Security') }}
								</div>
							{% endif %}

							<!-- Flash messages -->
							{% for type, messages in app.session.flashbag.all() %}
								{% for message in messages %}
									<div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
										{{ message|raw }}
										<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
									</div>
								{% endfor %}
							{% endfor %}

							<!-- Form START -->
							{% if loginForm is defined %}
								{{ form_start(loginForm, {'method': 'POST', 'action': path('app_login'), 'attr': {'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}
									{{ form_errors(loginForm) }}
									<!-- Email -->
									<div class="mb-4">
										<label for="{{ loginForm.email.vars.id }}" class="form-label">Email address *</label>
										<div class="input-group input-group-lg">
											<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="bi bi-envelope-fill"></i></span>
											{{ form_widget(loginForm.email, {'attr': {'class': 'form-control border-0 bg-light rounded-end ps-1', 'placeholder': 'Enter your email', 'value': last_username, 'novalidate': 'novalidate'}}) }}
										</div>
										{{ form_errors(loginForm.email) }}
									</div>
									<!-- Password -->
									<div class="mb-4">
										<label for="{{ loginForm.password.vars.id }}" class="form-label">Password *</label>
										<div class="input-group input-group-lg">
											<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="fas fa-lock"></i></span>
											{{ form_widget(loginForm.password, {'attr': {'class': 'form-control border-0 bg-light rounded-end ps-1', 'placeholder': 'Enter your password', 'novalidate': 'novalidate'}}) }}
										</div>
										{{ form_errors(loginForm.password) }}
									</div>
									<!-- Remember me -->
									<div class="mb-4">
										<div class="form-check">
											<input type="checkbox" class="form-check-input" id="rememberme" name="_remember_me">
											<label class="form-check-label" for="rememberme">Remember me</label>
										</div>
									</div>
									<!-- Button -->
									<div class="align-items-center mt-0">
										<div class="d-grid">
											<button type="submit" class="btn btn-primary mb-0">Sign In</button>
										</div>
									</div>
									<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
									<!-- reCAPTCHA -->
									<div class="mb-4">
										<div class="d-flex justify-content-center">
											<div class="g-recaptcha" data-sitekey="{{ google_recaptcha_site_key }}" data-callback="enableLoginButtons" data-expired-callback="disableLoginButtons"></div>
										</div>
									</div>
								{{ form_end(loginForm) }}
							{% else %}
								<form method="post" action="{{ path('app_login') }}" novalidate>
									<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
									<!-- Email -->
									<div class="mb-4">
										<label for="inputEmail" class="form-label">Email address *</label>
										<div class="input-group input-group-lg">
											<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="bi bi-envelope-fill"></i></span>
											<input type="email" class="form-control border-0 bg-light rounded-end ps-1" name="email" id="inputEmail" placeholder="Enter your email" value="{{ last_username is defined ? last_username : '' }}">
										</div>
									</div>
									<!-- Password -->
									<div class="mb-4">
										<label for="inputPassword" class="form-label">Password *</label>
										<div class="input-group input-group-lg">
											<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="fas fa-lock"></i></span>
											<input type="password" class="form-control border-0 bg-light rounded-end ps-1" name="password" id="inputPassword" placeholder="Enter your password">
										</div>
									</div>
									<!-- Remember me -->
									<div class="mb-4">
										<div class="form-check">
											<input type="checkbox" class="form-check-input" id="rememberme2" name="_remember_me">
											<label class="form-check-label" for="rememberme2">Remember me</label>
										</div>
									</div>
									<!-- reCAPTCHA -->
									<div class="mb-4">
										<div class="d-flex justify-content-center">
											<div class="g-recaptcha" data-sitekey="{{ google_recaptcha_site_key }}" data-callback="enableLoginButtons" data-expired-callback="disableLoginButtons"></div>
										</div>
									</div>
									<!-- Button -->
									<div class="align-items-center mt-0">
										<div class="d-grid">
											<button type="submit" class="btn btn-primary mb-0">Sign In</button>
										</div>
									</div>
								</form>
							{% endif %}
							<!-- Form END -->

							<!-- Forgot Password Link -->
							<div class="mt-3 mb-2 text-center">
								<a href="{{ path('app_forgot_password') }}" class="text-primary text-decoration-none">
									<i class="fas fa-key me-1"></i>Forgot your password?
								</a>
							</div>

							<!-- Social buttons and divider -->
							<div class="row">
								<!-- Divider with text -->
								<div class="position-relative my-4">
									<hr>
									<p class="small position-absolute top-50 start-50 translate-middle bg-body px-5">Or</p>
								</div>

								<!-- Social btn -->
								<div class="col-xxl-6 d-grid">
									<a href="{{ path('auth_google') }}" class="btn bg-google mb-2 mb-xxl-0"><i class="fab fa-fw fa-google text-white me-2"></i>Login with Google</a>
								</div>
								<!-- Social btn -->
								<div class="col-xxl-6 d-grid">
									<a href="{{ path('auth_facebook') }}" class="btn bg-facebook mb-0"><i class="fab fa-fw fa-facebook-f me-2"></i>Login with Facebook</a>
								</div>
							</div>

							<!-- Face Login Button -->
							<div class="row mt-3">
								<div class="col-12 d-grid">
									<button type="button" id="toggleFaceLogin" class="btn btn-outline-success">
										<i class="fas fa-fingerprint me-2"></i>Login with Face Recognition
									</button>
								</div>
							</div>

							<!-- Face Login Section -->
							<div id="faceLoginSection" class="d-none mt-4">
								<div class="card border-success">
									<div class="card-header bg-success bg-opacity-10 text-success">
										<i class="fas fa-camera me-2"></i>Face Recognition Login
									</div>
									<div class="card-body">
										<p class="text-muted small mb-3">Enter your email above, complete reCAPTCHA, then verify your face to login.</p>
										<div class="text-center">
											<div class="position-relative mb-3" style="max-width: 400px; margin: 0 auto;">
												<video id="faceLoginVideo" width="100%" height="300" autoplay playsinline 
													   style="border-radius: 8px; background: #000;"></video>
												<canvas id="faceLoginCanvas" width="640" height="480" 
														style="border-radius: 8px; background: #f8f9fa; max-width: 100%; display: none;"></canvas>
											</div>
											<button type="button" id="startFaceLogin" class="btn btn-primary mb-2">
												<i class="fas fa-video me-2"></i>Start Camera
											</button>
											<button type="button" id="captureFaceLogin" class="btn btn-success d-none mb-2" disabled>
												<i class="fas fa-fingerprint me-2"></i>Verify Face
											</button>
											<div id="faceLoginStatus" class="small text-muted"></div>
										</div>
									</div>
								</div>
							</div>

							<!-- Sign up link -->
							<div class="mt-4 text-center">
								<span>Don't have an account? <a href="{{ path('app_sign_up') }}">Signup here</a></span>
							</div>
						</div>
					</div> <!-- Row END -->
				</div>
			</div> <!-- Row END -->
		</div>
	</section>
</main>
<!-- **************** MAIN CONTENT END **************** -->

<script>
    // Disable login buttons until reCAPTCHA is verified
    document.addEventListener('DOMContentLoaded', function() {
        // Get all submit buttons and social login buttons
        const submitButtons = document.querySelectorAll('button[type="submit"]');
        const socialButtons = document.querySelectorAll('.bg-google, .bg-facebook, .btn-google, .btn-facebook');
        
        // Initially disable all buttons
        submitButtons.forEach(btn => {
            btn.disabled = true;
            btn.classList.add('opacity-50');
        });
        
        socialButtons.forEach(btn => {
            btn.classList.add('disabled');
            btn.style.pointerEvents = 'none';
            btn.classList.add('opacity-50');
        });
    });
    
    // Called when reCAPTCHA is successfully completed
    function enableLoginButtons() {
        window.recaptchaVerified = true;
        window.recaptchaToken = grecaptcha.getResponse();
        
        const submitButtons = document.querySelectorAll('button[type="submit"]');
        const socialButtons = document.querySelectorAll('.bg-google, .bg-facebook, .btn-google, .btn-facebook');
        const captureBtn = document.getElementById('captureFaceLogin');
        
        submitButtons.forEach(btn => {
            btn.disabled = false;
            btn.classList.remove('opacity-50');
        });
        
        socialButtons.forEach(btn => {
            btn.classList.remove('disabled');
            btn.style.pointerEvents = 'auto';
            btn.classList.remove('opacity-50');
        });
        
        // Enable face login capture button if camera is started
        if (captureBtn && !captureBtn.classList.contains('d-none')) {
            captureBtn.disabled = false;
        }
    }
    
    // Called if reCAPTCHA expires
    function disableLoginButtons() {
        window.recaptchaVerified = false;
        window.recaptchaToken = null;
        
        const submitButtons = document.querySelectorAll('button[type="submit"]');
        const socialButtons = document.querySelectorAll('.bg-google, .bg-facebook, .btn-google, .btn-facebook');
        const captureBtn = document.getElementById('captureFaceLogin');
        
        submitButtons.forEach(btn => {
            btn.disabled = true;
            btn.classList.add('opacity-50');
        });
        
        socialButtons.forEach(btn => {
            btn.classList.add('disabled');
            btn.style.pointerEvents = 'none';
            btn.classList.add('opacity-50');
        });
        
        // Disable face login capture button
        if (captureBtn) {
            captureBtn.disabled = true;
        }
    }

    /**
     * Face Login JavaScript
     */
    if (typeof FaceAuth === 'undefined') {
        class FaceAuth {
            constructor() {
                this.video = null;
                this.canvas = null;
                this.stream = null;
                this.isInitialized = false;
            }

            async initWebcam(videoElementId, canvasElementId) {
                this.video = document.getElementById(videoElementId);
                this.canvas = document.getElementById(canvasElementId);

                if (!this.video || !this.canvas) {
                    console.error('Video or canvas element not found');
                    return false;
                }

                try {
                    this.stream = await navigator.mediaDevices.getUserMedia({
                        video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: 'user' },
                        audio: false
                    });

                    this.video.srcObject = this.stream;
                    this.video.style.display = 'block';
                    this.canvas.style.display = 'none';

                    return new Promise((resolve) => {
                        const timeout = setTimeout(() => {
                            this.isInitialized = true;
                            resolve(true);
                        }, 3000);

                        this.video.onloadedmetadata = () => {
                            clearTimeout(timeout);
                            this.video.play().then(() => {
                                this.isInitialized = true;
                                resolve(true);
                            }).catch(() => resolve(false));
                        };
                    });
                } catch (error) {
                    console.error('Error accessing webcam:', error);
                    this.isInitialized = false;
                    return false;
                }
            }

            captureImage() {
                if (!this.isInitialized || !this.video || !this.canvas) {
                    alert('Camera not initialized.');
                    return null;
                }

                const context = this.canvas.getContext('2d');
                this.canvas.width = this.video.videoWidth || 640;
                this.canvas.height = this.video.videoHeight || 480;
                context.drawImage(this.video, 0, 0, this.canvas.width, this.canvas.height);
                
                this.video.style.display = 'none';
                this.canvas.style.display = 'block';

                return this.canvas.toDataURL('image/jpeg', 0.9);
            }

            stopWebcam() {
                if (this.stream) {
                    this.stream.getTracks().forEach(track => track.stop());
                    this.stream = null;
                }
                if (this.video) {
                    this.video.srcObject = null;
                }
                this.isInitialized = false;
            }
        }

        window.FaceAuth = FaceAuth;
    }

    // Initialize face login handlers
    document.addEventListener('DOMContentLoaded', function() {
        const toggleBtn = document.getElementById('toggleFaceLogin');
        const faceLoginSection = document.getElementById('faceLoginSection');
        const startBtn = document.getElementById('startFaceLogin');
        const captureBtn = document.getElementById('captureFaceLogin');
        const statusDiv = document.getElementById('faceLoginStatus');
        
        if (!toggleBtn || !faceLoginSection) return;

        const faceAuth = new FaceAuth();
        let cameraStarted = false;

        // Toggle face login section
        toggleBtn.addEventListener('click', () => {
            // Check email is not empty before showing face login
            const emailInput = document.getElementById('inputEmail');
            if (!emailInput || !emailInput.value.trim()) {
                alert('Please enter your email address first.');
                if (emailInput) emailInput.focus();
                return;
            }
            
            faceLoginSection.classList.toggle('d-none');
            if (!faceLoginSection.classList.contains('d-none')) {
                statusDiv.textContent = 'Complete reCAPTCHA, then click "Start Camera"';
            } else {
                faceAuth.stopWebcam();
                cameraStarted = false;
            }
        });

        // Start camera
        startBtn.addEventListener('click', async () => {
            startBtn.disabled = true;
            startBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Starting...';
            statusDiv.textContent = 'Requesting camera access...';
            
            const success = await faceAuth.initWebcam('faceLoginVideo', 'faceLoginCanvas');
            if (success) {
                cameraStarted = true;
                startBtn.classList.add('d-none');
                captureBtn.classList.remove('d-none');
                captureBtn.disabled = !window.recaptchaVerified;
                statusDiv.textContent = window.recaptchaVerified 
                    ? 'Position your face and click "Verify Face"' 
                    : 'Please complete reCAPTCHA first';
            } else {
                startBtn.disabled = false;
                startBtn.innerHTML = '<i class="fas fa-video me-2"></i>Start Camera';
                statusDiv.textContent = 'Could not access camera. Please check permissions.';
            }
        });

        // Capture and verify face
        captureBtn.addEventListener('click', async () => {
            if (!cameraStarted) {
                alert('Camera not ready.');
                return;
            }
            
            captureBtn.disabled = true;
            captureBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Verifying...';
            statusDiv.textContent = 'Verifying your face...';
            
            const imageData = faceAuth.captureImage();
            if (!imageData) {
                captureBtn.disabled = false;
                captureBtn.innerHTML = '<i class="fas fa-fingerprint me-2"></i>Verify Face';
                statusDiv.textContent = 'Failed to capture image. Try again.';
                return;
            }

            // Send to server for verification
            try {
                // Read values directly at send time
                const emailInput = document.getElementById('inputEmail');
                const emailValue = emailInput ? emailInput.value.trim() : '';
                
                if (!emailValue) {
                    alert('Please enter your email address first.');
                    captureBtn.disabled = false;
                    captureBtn.innerHTML = '<i class="fas fa-fingerprint me-2"></i>Verify Face';
                    return;
                }
                
                // Get reCAPTCHA token from the global variable set by enableLoginButtons
                const tokenValue = window.recaptchaToken || grecaptcha.getResponse();
                
                if (!tokenValue) {
                    alert('Please complete reCAPTCHA first.');
                    captureBtn.disabled = false;
                    captureBtn.innerHTML = '<i class="fas fa-fingerprint me-2"></i>Verify Face';
                    return;
                }
                
                const response = await fetch('/face-auth/verify', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ 
                        image: imageData,
                        email: emailValue,
                        recaptchaToken: tokenValue
                    })
                });

                if (response.redirected) {
                    window.location.href = response.url;
                    return;
                }

                const data = await response.json();

                if (data.success) {
                    statusDiv.innerHTML = '<span class="text-success"><i class="fas fa-check"></i> Success! Redirecting...</span>';
                    if (data.redirect) {
                        window.location.href = data.redirect;
                    }
                } else {
                    statusDiv.innerHTML = '<span class="text-danger"><i class="fas fa-times"></i> ' + (data.error || 'Face not recognized') + '</span>';
                    captureBtn.disabled = false;
                    captureBtn.innerHTML = '<i class="fas fa-fingerprint me-2"></i>Verify Face';
                    
                    setTimeout(() => {
                        faceAuth.stopWebcam();
                        faceAuth.initWebcam('faceLoginVideo', 'faceLoginCanvas');
                    }, 2000);
                }
            } catch (error) {
                console.error('Error:', error);
                statusDiv.innerHTML = '<span class="text-danger">Network error. Please try again.</span>';
                captureBtn.disabled = false;
                captureBtn.innerHTML = '<i class="fas fa-fingerprint me-2"></i>Verify Face';
            }
        });
    });
</script>

{% endblock %}
