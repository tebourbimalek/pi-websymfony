{% extends 'front_base.html.twig' %}

{% block title %}My Certificates{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.certificates-container {
    padding: 2rem 0;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    min-height: calc(100vh - 400px);
}

.page-header {
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    padding: 2rem;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
}

.page-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.page-title {
    color: #2c3e50;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.page-subtitle {
    color: #6c757d;
    margin-bottom: 0;
}

.stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.stat-card {
    background: white;
    border-radius: 15px;
    padding: 1.5rem;
    box-shadow: 0 3px 15px rgba(0,0,0,0.08);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}

.stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    color: #667eea;
    margin-bottom: 0.5rem;
}

.stat-label {
    color: #6c757d;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.certificates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
}

.certificate-card {
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
}

.certificate-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
}

.certificate-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 1.5rem;
    position: relative;
}

.certificate-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
}

.certificate-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.certificate-course {
    opacity: 0.9;
    font-size: 0.9rem;
}

.certificate-body {
    padding: 1.5rem;
}

.certificate-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.certificate-score {
    font-size: 1.5rem;
    font-weight: 700;
    color: #28a745;
}

.certificate-date {
    color: #6c757d;
    font-size: 0.9rem;
}

.certificate-actions {
    display: flex;
    gap: 0.5rem;
}

.btn-certificate {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
}

.btn-download {
    background: #28a745;
    color: white;
}

.btn-download:hover {
    background: #218838;
    transform: translateY(-2px);
}

.btn-view {
    background: #6c757d;
    color: white;
}

.btn-view:hover {
    background: #5a6268;
    transform: translateY(-2px);
}

.btn-regenerate {
    background: #ffc107;
    color: #212529;
}

.btn-regenerate:hover {
    background: #e0a800;
    transform: translateY(-2px);
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
}

.empty-icon {
    font-size: 4rem;
    color: #dee2e6;
    margin-bottom: 1.5rem;
}

.empty-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #495057;
    margin-bottom: 1rem;
}

.empty-text {
    color: #6c757d;
    margin-bottom: 2rem;
}

.btn-browse-courses {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 0.75rem 2rem;
    border: none;
    border-radius: 25px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
}

.btn-browse-courses:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
}

@media (max-width: 768px) {
    .certificates-grid {
        grid-template-columns: 1fr;
    }
    
    .stats-row {
        grid-template-columns: 1fr;
    }
    
    .certificate-actions {
        flex-direction: column;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="certificates-container">
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-certificate me-3"></i>My Certificates
            </h1>
            <p class="page-subtitle">View and download your earned certificates</p>
        </div>

        <!-- Statistics -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-number">{{ certificates|length + passedQuizResults|length }}</div>
                <div class="stat-label">Total Certificates</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ certificates|length }}</div>
                <div class="stat-label">Downloaded</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ passedQuizResults|length - certificates|length }}</div>
                <div class="stat-label">Available to Download</div>
            </div>
        </div>

        <!-- Certificates Grid -->
        {% if certificates|length > 0 or passedQuizResults|length > 0 %}
            <div class="certificates-grid">
                {% for certificate in certificates %}
                    <div class="certificate-card">
                        <div class="certificate-header">
                            <div class="certificate-badge">Downloaded</div>
                            <h3 class="certificate-title">Certificate of Completion</h3>
                            <div class="certificate-course">{{ certificate.course.title|default('Unknown Course') }}</div>
                        </div>
                        <div class="certificate-body">
                            <div class="certificate-info">
                                <div>
                                    <div class="certificate-score">{{ certificate.quizResult is not null ? certificate.quizResult.percentage : 0 }}%</div>
                                    <small class="text-muted">Score</small>
                                </div>
                                <div class="text-end">
                                    <div class="certificate-date">{{ certificate.generatedAt|date('M j, Y') }}</div>
                                    <small class="text-muted">Generated</small>
                                </div>
                            </div>
                            <div class="certificate-info">
                                <div>
                                    <small class="text-muted">Downloaded {{ certificate.downloadCount }} times</small>
                                </div>
                                {% if certificate.lastDownloadedAt %}
                                    <div class="text-end">
                                        <small class="text-muted">Last: {{ certificate.lastDownloadedAt|date('M j, Y') }}</small>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="certificate-actions">
                                {% if certificate.quizResult is not null %}
                                    <a href="{{ path('quiz_download_pdf', {'id': certificate.quizResult.id}) }}" class="btn-certificate btn-download">
                                        <i class="fas fa-download me-1"></i>Download
                                    </a>
                                    <a href="{{ path('quiz_certificate', {'id': certificate.quizResult.id}) }}" class="btn-certificate btn-view">
                                        <i class="fas fa-eye me-1"></i>View
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}

                {% for quizResult in passedQuizResults %}
                    {% set isDownloaded = false %}
                    {% set currentQuizResult = quizResult %}
                    {% if currentQuizResult is iterable %}
                        {% set currentQuizResult = quizResult[0] %}
                    {% endif %}
                    
                    {% for certificate in certificates %}
                        {% if certificate.quizResult is not null and certificate.quizResult.id == currentQuizResult.id %}
                            {% set isDownloaded = true %}
                        {% endif %}
                    {% endfor %}
                    
                    {% if not isDownloaded %}
                        {% set course = currentQuizResult.quiz is not null ? currentQuizResult.quiz.course : null %}
                        <div class="certificate-card">
                            <div class="certificate-header">
                                <div class="certificate-badge">Available</div>
                                <h3 class="certificate-title">Certificate of Completion</h3>
                                <div class="certificate-course">{{ course.title|default('Unknown Course') }}</div>
                            </div>
                            <div class="certificate-body">
                                <div class="certificate-info">
                                    <div>
                                        <div class="certificate-score">{{ currentQuizResult.percentage }}%</div>
                                        <small class="text-muted">Score</small>
                                    </div>
                                    <div class="text-end">
                                        <div class="certificate-date">{{ currentQuizResult.takenAt|date('M j, Y') }}</div>
                                        <small class="text-muted">Completed</small>
                                    </div>
                                </div>
                                <div class="certificate-actions">
                                    <a href="{{ path('quiz_download_pdf', {'id': currentQuizResult.id}) }}" class="btn-certificate btn-download">
                                        <i class="fas fa-download me-1"></i>Download
                                    </a>
                                    <a href="{{ path('quiz_certificate', {'id': currentQuizResult.id}) }}" class="btn-certificate btn-view">
                                        <i class="fas fa-eye me-1"></i>View
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% else %}
            <!-- Empty State -->
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-certificate"></i>
                </div>
                <h2 class="empty-title">No Certificates Yet</h2>
                <p class="empty-text">
                    You haven't earned any certificates yet. Complete courses with a score of 80% or higher to earn certificates!
                </p>
                <a href="{{ path('app_course_grid') }}" class="btn-browse-courses">
                    <i class="fas fa-graduation-cap me-2"></i>Browse Courses
                </a>
            </div>
        {% endif %}
    </div>
</div>

<!-- Include Footer -->
{% include 'components/footer.html.twig' %}
{% endblock %}
